          "ref"
        ],
        "title": "SecretRef",
        "type": "object",
        "writeOnly": true
      }
    },
    "additionalProperties": false,
    "description": "SSC connection settings. ``base_url`` is the operator root, normally ``https://host/ssc``.",
    "properties": {
      "allow_plain_http_loopback": {
        "default": false,
        "title": "Allow Plain Http Loopback",
        "type": "boolean"
      },
      "api_token": {
        "$ref": "#/$defs/SecretRef",
        "writeOnly": true
      },
      "base_url": {
        "title": "Base Url",
        "type": "string"
      },
      "ca_bundle_pem": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Ca Bundle Pem"
      },
      "client_cert": {
        "anyOf": [
          {
            "$ref": "#/$defs/SecretRef"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "writeOnly": true
      },
      "client_key": {
        "anyOf": [
          {
            "$ref": "#/$defs/SecretRef"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "writeOnly": true
      },
      "destructive_enabled": {
        "default": false,
        "title": "Destructive Enabled",
        "type": "boolean"
      },
      "fpr_location_semantics": {
        "default": "source_location_v2",
        "enum": [
          "source_location_v2",
          "snippet_start_v1"
        ],
        "title": "Fpr Location Semantics",
        "type": "string"
      },
      "proxy_url": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Proxy Url"
      },
      "timeout_s": {
        "default": 30,
        "exclusiveMinimum": 0,
        "title": "Timeout S",
        "type": "number"
      },
      "webhook_secret": {
        "anyOf": [
          {
            "$ref": "#/$defs/SecretRef"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "writeOnly": true
      },
      "write_enabled": {
        "default": false,
        "title": "Write Enabled",
        "type": "boolean"
      }
    },
    "required": [
      "base_url",
      "api_token"
    ],
    "title": "FortifySscConfig",
    "type": "object"
  },
