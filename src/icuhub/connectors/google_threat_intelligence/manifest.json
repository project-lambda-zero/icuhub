        "title": "SecretRef",
        "type": "object",
        "writeOnly": true
      }
    },
    "additionalProperties": false,
    "properties": {
      "allow_plain_http_loopback": {
        "default": false,
        "title": "Allow Plain Http Loopback",
        "type": "boolean"
      },
      "api_key": {
        "$ref": "#/$defs/SecretRef",
        "writeOnly": true
      },
      "base_url": {
        "default": "https://www.virustotal.com/api/v3",
        "title": "Base Url",
        "type": "string"
      },
      "ca_bundle_pem": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Ca Bundle Pem"
      },
      "client_cert": {
        "anyOf": [
          {
            "$ref": "#/$defs/SecretRef"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "writeOnly": true
      },
      "client_key": {
        "anyOf": [
          {
            "$ref": "#/$defs/SecretRef"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "writeOnly": true
      },
