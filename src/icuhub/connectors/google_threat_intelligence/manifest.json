        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Proxy Url"
      },
      "timeout_s": {
        "default": 30,
        "exclusiveMinimum": 0,
        "title": "Timeout S",
        "type": "number"
      }
    },
    "required": [
      "api_key"
    ],
    "title": "GtiConfig",
    "type": "object"
  },
