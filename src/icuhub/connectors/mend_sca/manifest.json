  "config_schema": {
    "$defs": {
      "SecretRef": {
        "additionalProperties": false,
        "description": "An opaque credential-broker reference, never secret material.",
        "properties": {
          "ref": {
            "minLength": 1,
            "title": "Ref",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "ref"
        ],
        "title": "SecretRef",
        "type": "object",
        "writeOnly": true
      }
    },
    "additionalProperties": false,
    "description": "One explicitly versioned Mend organization connection.\n\nAPI 2.0 and 3.0 tokens are intentionally never shared by this configuration. A\ndeployment covering the same organization through both APIs needs two connections.",
    "properties": {
      "allow_plain_http_loopback": {
        "default": false,
        "title": "Allow Plain Http Loopback",
        "type": "boolean"
      },
      "api_version": {
        "enum": [
          "3.0",
          "2.0"
        ],
        "title": "Api Version",
        "type": "string"
      },
      "base_url": {
        "default": "https://api-saas.mend.io",
        "title": "Base Url",
        "type": "string"
      },
      "ca_bundle_pem": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Ca Bundle Pem"
      },
      "client_cert": {
        "anyOf": [
          {
            "$ref": "#/$defs/SecretRef"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "writeOnly": true
      },
      "client_key": {
        "anyOf": [
          {
            "$ref": "#/$defs/SecretRef"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "writeOnly": true
      },
      "email": {
        "maxLength": 320,
        "minLength": 3,
        "title": "Email",
        "type": "string"
      },
      "max_pages": {
        "default": 10000,
        "maximum": 100000,
        "minimum": 1,
        "title": "Max Pages",
        "type": "integer"
      },
      "max_report_bytes": {
        "default": 33554432,
        "maximum": 268435456,
        "minimum": 1024,
        "title": "Max Report Bytes",
        "type": "integer"
      },
      "max_report_depth": {
        "default": 64,
        "maximum": 128,
        "minimum": 4,
        "title": "Max Report Depth",
        "type": "integer"
      },
      "max_report_items": {
        "default": 200000,
        "maximum": 1000000,
        "minimum": 1,
        "title": "Max Report Items",
        "type": "integer"
      },
      "max_report_string_chars": {
        "default": 1048576,
        "maximum": 16777216,
        "minimum": 128,
        "title": "Max Report String Chars",
        "type": "integer"
      },
      "max_sbom_bytes": {
        "default": 16777216,
        "maximum": 67108864,
        "minimum": 1024,
        "title": "Max Sbom Bytes",
        "type": "integer"
      },
      "org_token": {
        "anyOf": [
          {
            "$ref": "#/$defs/SecretRef"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "writeOnly": true
      },
      "org_uuid": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z0-9_.:-]{1,256}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Org Uuid"
      },
      "page_size": {
        "default": 50,
        "maximum": 10000,
        "minimum": 1,
        "title": "Page Size",
        "type": "integer"
      },
      "proxy_url": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Proxy Url"
      },
      "selected_projects": {
        "items": {
          "type": "string"
        },
        "maxItems": 100000,
        "title": "Selected Projects",
        "type": "array"
      },
      "stale_after_days": {
        "default": 30,
        "maximum": 3650,
        "minimum": 1,
        "title": "Stale After Days",
        "type": "integer"
      },
      "timeout_s": {
        "default": 30,
        "exclusiveMinimum": 0,
        "title": "Timeout S",
        "type": "number"
      },
      "user_key": {
        "$ref": "#/$defs/SecretRef",
        "writeOnly": true
      },
      "write_enabled": {
        "default": false,
        "title": "Write Enabled",
        "type": "boolean"
      }
    },
    "required": [
      "api_version",
      "email",
      "user_key"
    ],
    "title": "MendSCAConfig",
    "type": "object"
  },
